QMainWindow {
    background-color: #0d0e11;
}

#stage {
    background-color: transparent;
}

#topPanel, #modelCard {
    background-color: #16171b;
    border: 1px solid #23252b;
    border-radius: 8px;
}

#svCanvas, #hueBar, #previewBox {
    background-color: #0f1013;
    border: 1px solid #2a2d35;
    border-radius: 4px;
}

#titleLabel {
    color: #f0f6fc;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#cardTitle {
    color: #f0f6fc;
    font-size: 13px;
    font-weight: 700;
}

#rowLabel {
    color: #8b949e;
    font-size: 11px;
    font-weight: 700;
}

#rowInput, QDoubleSpinBox {
    background-color: #0f1013;
    border: 1px solid #23252b;
    border-radius: 4px;
    color: #e6edf3;
    font-family: monospace;
    font-size: 12px;
    padding: 3px 6px;
}

#rowInput:focus, QDoubleSpinBox:focus {
    border: 1px solid #3b82f6;
}

#rowCopyBtn {
    background-color: #1b1d22;
    border: 1px solid #282a30;
    border-radius: 4px;
}

#rowCopyBtn:hover {
    background-color: #262930;
    border-color: #3b82f6;
}

#dataConsole {
    background-color: #0f1013;
    border: 1px solid #23252b;
    border-radius: 4px;
    color: #a5b4fc;
    font-family: monospace;
    font-size: 11px;
    padding: 8px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #23252b;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #3b82f6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #e6edf3;
    width: 12px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

#mkoBtn {
    background-color: #1b1d22;
    border: 1px solid #282a30;
    border-radius: 4px;
    color: #f0f6fc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

#mkoBtn:hover {
    background-color: #262930;
    border-color: #3b82f6;
    color: #ffffff;
}

#mkoBtn:pressed {
    background-color: #16171b;
}
